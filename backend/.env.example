# Copy to backend/.env and fill in real values (never commit .env).

# Database (Neon Postgres connection string)
DATABASE_URL=postgresql://user:password@localhost:5432/ai_tutor

# JWT Secret (generate a secure key for production)
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Qdrant Vector Database (the whole team must use the same collection)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION_NAME=ai-assisted-learning-document

# File storage - Cloudflare R2 (shared by every machine/server).
# Leave all four empty to store files in backend/storage/ on this machine only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Browser origins allowed to call the API (add the deployed frontend URL)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM (OpenAI)
LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Number of recent messages fed to the LLM as conversation memory.
ASK_MEMORY_MESSAGES=50

# Embedding (Google Gemini API). The dimension must match the Qdrant collection.
GEMINI_EMBEDDING_API_KEY=your-gemini-api-key
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
